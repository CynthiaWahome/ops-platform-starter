PORT=8080
APP_ENV=development
AUTH_TOKEN_SECRET=change-me-super-secret
AUTH_TOKEN_TTL_MINUTES=60
BOOTSTRAP_ADMIN_IDENTIFIER=admin@ops.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin
BOOTSTRAP_ASSIGNEE_IDENTIFIER=assignee@ops.local
BOOTSTRAP_ASSIGNEE_PASSWORD=ChangeMe123!
BOOTSTRAP_ASSIGNEE_DISPLAY_NAME=Assigned Worker
BOOTSTRAP_SUPERVISOR_IDENTIFIER=supervisor@ops.local
BOOTSTRAP_SUPERVISOR_PASSWORD=ChangeMe123!
BOOTSTRAP_SUPERVISOR_DISPLAY_NAME=Team Supervisor
BOOTSTRAP_REQUESTER_IDENTIFIER=requester@ops.local
BOOTSTRAP_REQUESTER_PASSWORD=ChangeMe123!
BOOTSTRAP_REQUESTER_DISPLAY_NAME=Requesting Customer

# Optional, commented out on purpose — leave it that way unless you've
# actually started Postgres first (`docker compose up -d`). Unset/empty
# (the default) runs entirely in memory, no setup, data resets every
# restart. Now that .env actually loads (see cmd/api/main.go), an
# uncommented value here with no database running would fail the
# startup connection check instead of silently falling back — uncomment
# only once Postgres is actually up.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ops_platform?sslmode=disable
